//new2
pipeline {
    agent any

    environment {
        AWS_REGION = "ap-south-1"
        ACCOUNT_ID = "308855860105"
        ECR_REPO = "backend-app"
        IMAGE_TAG = "latest"
        CONTAINER_NAME = "backend"
        HOST_PORT = "5000"
        CONTAINER_PORT = "5000"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/rahul4793/Capstone-Project-Corporate-Banking-Loan-Pricing-Deal-Approval-System.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Corporate_Banking_Backend') {
                    sh "docker build -t $ECR_REPO:$IMAGE_TAG ."
                }
            }
        }

        stage('Login to ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                    | docker login --username AWS --password-stdin $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                    '''
                }
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                sh '''
                docker tag $ECR_REPO:$IMAGE_TAG $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:$IMAGE_TAG
                docker push $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:$IMAGE_TAG
                '''
            }
        }

stage('Deploy Backend') {
    steps {
        script {
            echo "🚀 Starting deployment..."

            // Stop and remove existing container
            echo "🔹 Stopping existing container (if any)..."
            sh "docker ps -a -q -f name=${CONTAINER_NAME} | xargs -r docker stop || true"
            sh "docker ps -a -q -f name=${CONTAINER_NAME} | xargs -r docker rm || true"

            // Kill any process using the port
            echo "🔹 Checking if port ${HOST_PORT} is in use..."
            sh """
            PORT_PID=\$(lsof -ti:${HOST_PORT} || true)
            echo "PORT_PID: \$PORT_PID"
            if [ ! -z "\$PORT_PID" ]; then
                echo "⚠️ Killing process on port ${HOST_PORT}: \$PORT_PID"
                kill -9 \$PORT_PID
            else
                echo "✅ Port ${HOST_PORT} is free"
            fi
            """

            // Run the new container
            echo "🔹 Running new container..."
            sh "docker run -d -p ${HOST_PORT}:${HOST_PORT} --name ${CONTAINER_NAME} ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"
            echo "✅ Deployment command executed"
        }
    }
}

    }

    post {
        success {
            echo "✅ Backend deployed successfully on port $HOST_PORT"
        }
        failure {
            echo "❌ Pipeline failed. Check logs above for details."
        }
    }
}
