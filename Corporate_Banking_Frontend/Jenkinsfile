pipeline {
    agent any

    environment {
        AWS_REGION       = "ap-south-1"
        ACCOUNT_ID       = "308855860105"
        ECR_REPO         = "frontend-app"
        IMAGE_TAG        = "latest"
        CONTAINER_NAME   = "frontend"
        HOST_PORT        = "80"
        CONTAINER_PORT   = "80"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "🔹 Checking out code from GitHub..."
                git branch: 'main',
                    url: 'https://github.com/rahul4793/Capstone-Project-Corporate-Banking-Loan-Pricing-Deal-Approval-System.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "🔹 Building Docker image..."
                dir('Corporate_Banking_Frontend') {
                    sh """
                    docker build -t $ECR_REPO:$IMAGE_TAG .
                    """
                }
            }
        }

        stage('Login to ECR') {
            steps {
                echo "🔹 Logging in to ECR..."
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                    | docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    '''
                }
            }
        }

stage('Push Docker Image to ECR') {
    steps {
        sh """
        docker tag ${ECR_REPO}:${IMAGE_TAG} \
        ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}

        docker push \
        ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
        """
    }
}

        stage('Deploy Frontend') {
            steps {
                script {
                    echo "🚀 Deploying frontend..."

                    // Stop and remove existing container
                    echo "🔹 Stopping existing container (if any)..."
                    sh "docker ps -a -q -f name=${CONTAINER_NAME} | xargs -r docker stop || true"
                    sh "docker ps -a -q -f name=${CONTAINER_NAME} | xargs -r docker rm || true"

                    // Kill any process using the port
                    echo "🔹 Checking if port ${HOST_PORT} is in use..."
                    sh """
                    PORT_PID=\$(lsof -ti:${HOST_PORT} || true)
                    echo "PORT_PID: \$PORT_PID"
                    if [ ! -z "\$PORT_PID" ]; then
                        echo "⚠️ Killing process on port ${HOST_PORT}: \$PORT_PID"
                        kill -9 \$PORT_PID
                    else
                        echo "✅ Port ${HOST_PORT} is free"
                    fi
                    """

                    // Run the new container
                    echo "🔹 Running new container..."
                    sh "docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} --name ${CONTAINER_NAME} $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:$IMAGE_TAG"
                    echo "✅ Frontend deployed successfully"
                }
            }
        }

    }

    post {
        success {
            echo "🎉 Frontend pipeline completed successfully!"
        }
        failure {
            echo "❌ Frontend pipeline failed. Check the logs above for details."
        }
    }
}
